[include]
    path = ./.config/delta/themes.gitconfig

[core]
    # No -w: COLUMNS is a shell variable, not exported, so the pager subshell
    # git spawns saw an empty width and delta exited with
    #   "a value is required for '--width <N>'".
    # Delta detects the terminal width itself; only fzf previews need a value,
    # and 0 there means "auto" rather than empty.
    pager = delta --side-by-side -w ${FZF_PREVIEW_COLUMNS:-0}

[interactive]
    diffFilter = delta --color-only

[delta]
    # navigate = true  # use n and N to move between diff sections
    # dark = true      # or light = true, or omit for auto-detection
    features = arctic-fox
    side-by-side = true

[merge]
    conflictstyle = zdiff3

[init]
	defaultBranch = main

[http]
	lowSpeedLimit = 1000
	lowSpeedTime = 60
	postBuffer = 524288000
