[include]
    path = ./.config/delta/themes.gitconfig

[core]
    # No -w at all. Delta measures the terminal itself; passing a width only
    # makes things worse here. COLUMNS is a shell variable and is not exported,
    # so the pager subshell git spawns saw an empty value and delta exited with
    #   "a value is required for '--width <N>'".
    # -w 0 is not "auto" either: delta takes it literally and renders columns of
    # zero width, so a real diff prints as blank lines and looks like no diff.
    # side-by-side lives in [delta] below, so nothing is needed on this line.
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    # navigate = true  # use n and N to move between diff sections
    # dark = true      # or light = true, or omit for auto-detection
    features = arctic-fox
    side-by-side = true

[merge]
    conflictstyle = zdiff3

[init]
	defaultBranch = main

[http]
	lowSpeedLimit = 1000
	lowSpeedTime = 60
	postBuffer = 524288000
