#!/bin/sh
# dotenv-apply: apply ~/.config/environment.d/*.conf to the CURRENT shell.
# This is the single consumer that both fish and bash use so neither shell
# maintains its own copy of env vars or PATH. You only ever edit those files.
#
# Usage from bash:   eval "$(dotenv-apply)"
# Usage from fish:   dotenv-apply | source        (emits `set -gx` when fish)
#
# Every *.conf in the directory is read in lexical order, later files winning,
# matching systemd's environment.d drop-in semantics -- so a host-specific
# override (zz-wsl.conf) can replace PATH without forking dotenv.conf. On hosts
# without systemd (WSL2) this script is the ONLY consumer, and it needs nothing
# from systemd; skip the dotenv-export.service half there.
#
# It expands $HOME, ignores comments/blank lines, and prints export commands
# for the calling shell. PATH is exported as-is (already fully expanded).
#
# Output is cached per shell and reused while it is newer than every conf.
# The parse loop forks 3x per line (~47ms on this conf) and ran on every
# interactive shell; the cached path is a single cat. Edit any conf and the
# mtime check regenerates it on the next shell.

# $@ becomes the conf list. DOTENV_CONF still names one explicit file, which
# the self-check relies on; otherwise glob the drop-in directory.
if [ -n "$DOTENV_CONF" ]; then
    [ -f "$DOTENV_CONF" ] || exit 0
    confs="$DOTENV_CONF"
else
    confs=""
    for f in "${DOTENV_DIR:-$HOME/.config/environment.d}"/*.conf; do
        [ -f "$f" ] && confs="$confs$f
"
    done
    [ -n "$confs" ] || exit 0
fi

# Detect target shell from parent process / $0 fallback.
shell="sh"
case "${SHELL##*/}" in
    fish) shell=fish ;;
    bash) shell=bash ;;
esac
# fish passes through `| source`; allow explicit override: dotenv-apply fish
[ -n "$1" ] && shell="$1"

# Only cache the globbed default. An explicit DOTENV_CONF would collide on the
# cache key, so those callers always take the slow path.
CACHE=""
if [ -z "$DOTENV_CONF" ]; then
    CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/dotenv-apply.$shell"
    # Stale if ANY conf is newer than the cache, not just the first one.
    fresh=1
    echo "$confs" | while IFS= read -r f; do
        [ -n "$f" ] || continue
        [ "$CACHE" -nt "$f" ] || exit 1
    done || fresh=0
    [ "$fresh" = 1 ] && exec cat "$CACHE"
fi

emit() {
echo "$confs" | while IFS= read -r conf; do
[ -n "$conf" ] || continue
while IFS= read -r line || [ -n "$line" ]; do
    case $line in
        ''|\#*|\;*) continue ;;
    esac
    key=${line%%=*}
    value=${line#*=}
    # trim surrounding whitespace on key
    key=$(printf '%s' "$key" | tr -d ' \t')
    # strip one layer of matching surrounding quotes
    case $value in
        \"*\") value=${value#\"}; value=${value%\"} ;;
        \'*\') value=${value#\'}; value=${value%\'} ;;
    esac
    # Expand $HOME / ${HOME} textually. Never eval the value: environment.d is a
    # shared drop-in directory, and eval would run any $(...) or backticks a
    # conf contains on every interactive shell. The trailing two rules keep
    # $HOMEBREW-style names from matching the $HOME prefix.
    case $value in
        *'$HOME'*|*'${HOME}'*) value=$(printf '%s' "$value" | sed \
            -e "s|\${HOME}|$HOME|g" \
            -e "s|\$HOME\([^A-Za-z0-9_]\)|$HOME\1|g" \
            -e "s|\$HOME\$|$HOME|g") ;;
    esac
    case $shell in
        fish)
            # escape single quotes for fish
            esc=$(printf '%s' "$value" | sed "s/'/\\\\'/g")
            printf "set -gx %s '%s';\n" "$key" "$esc"
            ;;
        *)
            esc=$(printf '%s' "$value" | sed "s/'/'\\\\''/g")
            printf "export %s='%s';\n" "$key" "$esc"
            ;;
    esac
done < "$conf"
done
}

[ -n "$CACHE" ] || { emit; exit; }

# Write via tmp+rename so a concurrent shell never sources a half-written
# cache. Any failure falls back to emitting directly -- never a partial file.
mkdir -p "${CACHE%/*}" 2>/dev/null || { emit; exit; }
tmp="$CACHE.tmp.$$"
if emit > "$tmp" && mv -f "$tmp" "$CACHE"; then
    cat "$CACHE"
else
    rm -f "$tmp"
    emit
fi
